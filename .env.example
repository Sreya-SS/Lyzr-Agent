# Copy to .env.local and fill in. Never put real keys in THIS file — it's a
# committed template. Real secrets go in .env.local (gitignored).

# Required for the Mentor Agent — free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional — the Mentor originally used Anthropic; Groq replaced it. Leave blank.
ANTHROPIC_API_KEY=

# Optional — Phase 5 stretch goal (real retrieval execution against Qdrant).
QDRANT_URL=
QDRANT_API_KEY=
